<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: nada do aplicativo vai para o backup em nuvem nem para a
     transferência de dados entre aparelhos.

     O banco carrega a identidade do aparelho. Restaurado num celular novo
     enquanto o antigo continua em uso, os dois passariam a escrever com a
     mesma identidade, e a numeração das operações deixaria de dizer quem
     escreveu o quê. A cópia de segurança do próprio aplicativo (Ajustes →
     Exportar cópia) existe para isso, e não leva a identidade junto.
     Ver docs/copia-de-seguranca.md. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
