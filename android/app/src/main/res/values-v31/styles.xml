<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+: a abertura é desenhada pelo sistema, sempre com o ícone
         do aplicativo no centro. Fica estático, sobre a cor de fundo do tema,
         com o círculo do ícone em teal. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/fundo_abertura</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/ic_launcher_background</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@color/fundo_abertura</item>
    </style>
</resources>
