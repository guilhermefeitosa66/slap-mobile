<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Tema da janela enquanto o processo inicia, com o sistema em modo claro. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <!-- Tema da janela depois que o Flutter assume. Também é o fundo que
         aparece atrás da interface durante redimensionamentos: com a cor do
         tema, nada pisca em branco. -->
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@color/fundo_abertura</item>
    </style>
</resources>
